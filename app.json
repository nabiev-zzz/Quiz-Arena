{
  "expo": {
    "name": "ZELQEN CORE",
    "slug": "QUIZ-ARENA",
    "scheme": "quizarena",
    "version": "1.1.5",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "uz.quizarena.app",
      "versionCode": 11
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "name": "ZELQEN CORE",
      "shortName": "ZELQEN",
      "lang": "uz",
      "description": "ZELQEN CORE — bilimni o‘rganish, AI ustoz bilan shug‘ullanish va do‘stlar bilan bellashish platformasi."
    },
    "plugins": [
      "expo-secure-store",
      "expo-font",
      "expo-iap",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0B0B14"
        }
      ],
      "expo-video",
      "expo-sharing",
      [
        "expo-image-picker",
        { "photosPermission": "Allow ZELQEN CORE to access your photos so you can send images in private chats." }
      ],
      [
        "expo-audio",
        { "microphonePermission": "Allow ZELQEN CORE to access your microphone for voice messages." }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "001475e3-4cec-4e58-8eda-d11da02f66c9"
      }
    },
    "owner": "faxriyorkk",
    "experiments": {
      "baseUrl": "/app"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/001475e3-4cec-4e58-8eda-d11da02f66c9",
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    }
  }
}
